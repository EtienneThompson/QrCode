# Application id from the admin portal (admin.etiennethompson.com → Applications → QR Tracker).
VITE_APPLICATION_ID=

# Where api.etiennethompson.com is deployed. Leave empty in dev (Vite proxies /qr/ to localhost:4000).
VITE_API_BASE_URL=

# Optional. Defaults to https://login.etiennethompson.com.
# VITE_LOGIN_ENDPOINT=
# Optional. The login service sends you back to the registered redirect URL containing this.
# Defaults to the site's own host, e.g. qr.etiennethompson.com.
# VITE_LOGIN_REDIRECT=
